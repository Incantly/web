// Cloudflare Workers deployment through OpenNext. See docs/cloudflare-deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incantly-web",
  // Account that owns the incantly.xyz zone; keeps deploys off other signed-in accounts.
  "account_id": "79b6b8de858c7b48ada76dc9bd7415ba",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference required by OpenNext; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "incantly-web" }
  ],
  "images": { "binding": "IMAGES" },
  // Workers Logs, Traces and real-time Issues in the dashboard (Observability).
  // Query strings are redacted: OAuth callbacks carry the code and state there.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },
  // www is the canonical host; Cloudflare creates its DNS record and
  // certificate. The apex keeps its existing proxied record, so it uses a
  // route instead (a custom domain would require deleting that record), and
  // next.config.ts redirects it to www.
  "routes": [
    { "pattern": "www.incantly.xyz", "custom_domain": true },
    { "pattern": "incantly.xyz/*", "zone_name": "incantly.xyz" }
  ],
  "vars": {
    // Runtime copy only. The rewrite destination is fixed at build time, so
    // `npm run build:cf` also sets AUTH_BACKEND_URL for `next build`.
    "AUTH_BACKEND_URL": "https://api.incantly.xyz"
  },
  // Worker Previews (branch deploys) do not inherit the settings above, so
  // list what a Preview needs. This points at the production auth backend.
  "previews": {
    "vars": {
      "AUTH_BACKEND_URL": "https://api.incantly.xyz"
    },
    "images": { "binding": "IMAGES" }
  }
  // AUTH_PROXY_SECRET is a Worker secret: `npx wrangler secret put AUTH_PROXY_SECRET`.
}
